# PostgreSQL connection string (e.g. a Supabase/Neon/local Postgres database).
# Required by lib/db and Better Auth.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Public URL of the app. Used by Better Auth for callbacks/cookies.
# Defaults to http://localhost:3000 in local dev if unset.
BETTER_AUTH_URL="http://localhost:3000"

# Secret used to sign sessions/tokens. REQUIRED in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
